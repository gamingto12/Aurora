# Environment variables for Aurora Discord Bot
# Rename this file to .env and fill in the values before running the bot.
# Make sure to keep this file secure and never share it publicly, as it contains sensitive information.
# No variables need to be inside quotes, just replace the placeholders with your actual values.
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
OWNER_ID=your_discord_id_here
