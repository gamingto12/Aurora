# Environment variables for Aurora Discord Bot
# Rename this file to `.env` and fill in the values before running the bot.
# Keep this file private (do NOT commit secrets to Git).
# No values need to be wrapped in quotes — just replace the placeholders.

# Discord bot token (required)
# - Create a bot at https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Application (client) ID — used for building invite links (optional)
CLIENT_ID=your_client_id_here

# Your Discord user ID (owner) — used by owner-only commands
OWNER_ID=your_discord_id_here

# (Optional) Guild ID for development-only slash command registration
# - If set, slash commands are registered to this guild immediately (fast iteration).
# - Leave empty to register global commands (may take up to 1 hour to propagate).
GUILD_ID=your_server_id_here

# OpenWeatherMap API key (required for /weather and /time commands)
# - Get a free key from: https://openweathermap.org/api
OPENWEATHER_KEY=your_openweather_api_key_here

# Default units for weather when none specified: "imperial" | "metric" | "standard"
# - Recommended: imperial (°F) or metric (°C). The bot will still show both units in responses.
DEFAULT_WEATHER_UNITS=imperial
